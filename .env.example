# PopQA-RAG-Judge environment variables

# Paths
DATA_DIR=./data
INDEX_DIR=./index
SESSIONS_DIR=./sessions
LOGS_DIR=./logs
REPORTS_DIR=./reports

# Model configuration
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LOCAL_LLM=qwen2.5:3b-instruct-q4_K_M

# Retrieval and memory settings
TOP_K=5
DISPLAY_K=3
SIMILARITY_THRESHOLD=0.55
SLIDING_WINDOW_MEMORY=5

# Logging
LOG_LEVEL=INFO
